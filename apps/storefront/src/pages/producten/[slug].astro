---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { store, products, eur, productImage, productSrcset, u, type Product } from '../../lib/data';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props as { product: Product };
const url = new URL(u(`/producten/${p.slug}/`), Astro.site).href;
const related = products.filter((x) => x.slug !== p.slug && x.category === p.category).concat(products.filter((x) => x.slug !== p.slug && x.category !== p.category)).slice(0, 4);
const productLd = {
  '@context': 'https://schema.org', '@type': 'Product', name: p.name, description: p.copy.description,
  image: [new URL(u(`/assets/og/${p.slug}.png`), Astro.site).href], sku: `${store.id}-${p.slug}`, category: p.category,
  brand: { '@type': 'Brand', name: store.name },
  offers: {
    '@type': 'Offer', url, priceCurrency: 'EUR', price: p.price.toFixed(2), availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition',
    shippingDetails: { '@type': 'OfferShippingDetails', shippingRate: { '@type': 'MonetaryAmount', value: store.shipping.flatRate, currency: 'EUR' },
      shippingDestination: store.shipping.countries.map((c) => ({ '@type': 'DefinedRegion', addressCountry: c })),
      deliveryTime: { '@type': 'ShippingDeliveryTime', handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' }, transitTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 5, unitCode: 'DAY' } } },
    hasMerchantReturnPolicy: { '@type': 'MerchantReturnPolicy', applicableCountry: store.shipping.countries, returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow', merchantReturnDays: 14, returnMethod: 'https://schema.org/ReturnByMail', returnFees: 'https://schema.org/ReturnShippingFees' },
  },
};
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(u('/'), Astro.site).href },
  { '@type': 'ListItem', position: 2, name: 'Producten', item: new URL(u('/producten/'), Astro.site).href },
  { '@type': 'ListItem', position: 3, name: p.name, item: url },
] };
const faq = p.copy.faq ?? [];
const faqLd = faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : [];
const freeLeft = store.shipping.freeFrom - p.price;
---
<Base title={p.copy.metaTitle} description={p.copy.metaDescription} image={`/assets/og/${p.slug}.png`} jsonld={[productLd, crumbs, ...faqLd]}>
  <nav class="wrap crumbs" aria-label="Kruimelpad"><a href={u('/')}>Home</a> › <a href={u('/producten/')}>Producten</a> › <span>{p.name}</span></nav>
  <article class="wrap pdp" data-product={JSON.stringify({ slug: p.slug, name: p.name, price: p.price, category: p.category })}>
    <div class="media"><img src={productImage(p)} srcset={productSrcset(p)} sizes="(max-width: 820px) 100vw, 560px" alt={p.name} width="800" height="800" loading="eager" fetchpriority="high" /></div>
    <div class="info">
      <span class="muted cat">{p.category}</span>
      <h1>{p.name}</h1>
      <p class="tagline">{p.copy.tagline}</p>
      <p class="price big">{eur(p.price)} <span class="muted small">incl. btw</span></p>
      <ul class="bullets">{p.copy.bullets.map((b) => <li>{b}</li>)}</ul>
      <form class="buy" data-add-form>
        {p.variants && (
          <label>{p.variants.label}
            <select name="variant" required>{p.variants.options.map((o) => <option value={o}>{o}</option>)}</select>
          </label>
        )}
        <label>Aantal <input type="number" name="qty" min="1" max="10" value="1" inputmode="numeric" /></label>
        <button class="btn" type="submit">In winkelmand</button>
        <button class="btn ghost" type="button" data-buy-now>Direct afrekenen</button>
      </form>
      <p class="ship">🚚 {freeLeft > 0 ? `Gratis verzending vanaf ${eur(store.shipping.freeFrom)}` : 'Gratis verzending'} · Levering in {store.shipping.deliveryDays} · 14 dagen bedenktijd</p>
      <p class="muted small">Betaal veilig met Bancontact, iDEAL, kaart, Apple Pay of Google Pay.</p>
    </div>
  </article>
  <section class="wrap details">
    <div>
      <h2>Over dit product</h2>
      <p>{p.copy.description}</p>
      {p.copy.specs && (<><h3>Specificaties</h3><ul>{p.copy.specs.map((s) => <li>{s}</li>)}</ul></>)}
    </div>
    {faq.length > 0 && (
      <div class="faq">
        <h2>Vragen</h2>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    )}
  </section>
  <section class="wrap" style="margin-top:56px">
    <h2>Ook interessant</h2>
    <div class="grid">{related.map((r) => <ProductCard product={r} />)}</div>
  </section>
  <div class="sticky-buy" aria-hidden="true"><span><strong>{p.name}</strong> · {eur(p.price)}</span><button class="btn" data-sticky-add>In winkelmand</button></div>
</Base>
<style>
  .crumbs{padding-top:18px;font-size:.88rem}
  .crumbs a{opacity:.7}
  .pdp{display:grid;grid-template-columns:1fr 1fr;gap:44px;padding-top:18px}
  .media img{border-radius:24px;background:#fff}
  .cat{text-transform:uppercase;letter-spacing:.06em;font-size:.82rem}
  h1{font-size:clamp(1.8rem,3.6vw,2.6rem);margin:.2em 0}
  .tagline{font-size:1.2rem;margin:0 0 12px}
  .big{font-size:1.8rem;margin:8px 0 16px}
  .small{font-size:.85rem;font-weight:400}
  .bullets{padding-left:1.1em;margin:0 0 20px}
  .bullets li{margin:4px 0}
  .buy{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin:8px 0 14px}
  .buy label{display:flex;flex-direction:column;font-size:.85rem;font-weight:600;gap:4px}
  .buy select,.buy input{font:inherit;padding:.7em .8em;border-radius:12px;border:1px solid rgba(0,0,0,.2);background:#fff;min-width:90px}
  .ship{font-weight:600;font-size:.95rem}
  .details{display:grid;grid-template-columns:1.2fr .8fr;gap:44px;margin-top:40px}
  .faq details{background:#fff;border-radius:14px;padding:14px 18px;margin:10px 0}
  .faq summary{font-weight:700;cursor:pointer}
  .sticky-buy{display:none}
  @media (max-width:820px){
    .pdp,.details{grid-template-columns:1fr}
    .sticky-buy{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:30;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px;background:#fff;box-shadow:0 -6px 20px rgba(0,0,0,.08);font-size:.9rem}
    .sticky-buy .btn{padding:.7em 1.2em}
  }
</style>
