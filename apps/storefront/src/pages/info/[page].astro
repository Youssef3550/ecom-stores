---
import Base from '../../layouts/Base.astro';
import { store } from '../../lib/data';
import { legalPages, type LegalPage } from '../../lib/legal';
export function getStaticPaths() {
  return legalPages.map((p) => ({ params: { page: p.slug }, props: { page: p } }));
}
const { page } = Astro.props as { page: LegalPage };
---
<Base title={`${page.title} | ${store.name}`} description={page.description}>
  <article class="wrap legal" style="padding-top:40px;max-width:820px">
    <h1>{page.title}</h1>
    <Fragment set:html={page.html} />
  </article>
</Base>
<style>
  .legal :global(td),.legal :global(th){padding:10px;border-bottom:1px solid rgba(0,0,0,.08);vertical-align:top}
  .legal :global(h2){margin-top:32px}
</style>
