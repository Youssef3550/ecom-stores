---
import { store, u, DEMO, usesStockPhotos } from '../lib/data';
interface Props { title: string; description: string; image?: string; canonical?: string; jsonld?: object[]; noindex?: boolean }
const { title, description, image = '/assets/og/home.png', jsonld = [] } = Astro.props;
const noindex = Astro.props.noindex || process.env.PREVIEW === 'true';
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(u(image), Astro.site).href;
const { theme, analytics } = store;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: store.name, url: Astro.site?.href,
  email: store.company.email, logo: new URL(u('/favicon.svg'), Astro.site).href,
};
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={store.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="nl_BE" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content={theme.primary} />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
  <style is:global define:vars={{ primary: theme.primary, accent: theme.accent, bg: theme.bg, text: theme.text, font: theme.font }}>
    *,*::before,*::after{box-sizing:border-box}
    [hidden]{display:none!important}
    html{-webkit-text-size-adjust:100%}
    body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);line-height:1.55;font-size:17px}
    img,svg{max-width:100%;height:auto;display:block}
    .card img,.media img,.hero img,.bundle-imgs img{aspect-ratio:1/1;object-fit:cover;width:100%;background:#fff}
    a{color:inherit}
    .wrap{max-width:1160px;margin:0 auto;padding:0 20px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;border:0;border-radius:999px;padding:.9em 1.6em;font:inherit;font-weight:700;cursor:pointer;text-decoration:none;background:var(--primary);color:#fff;transition:transform .15s ease, filter .15s ease}
    .btn:hover{filter:brightness(1.08);transform:translateY(-1px)}
    .btn:focus-visible,a:focus-visible,button:focus-visible,select:focus-visible{outline:3px solid var(--primary);outline-offset:3px}
    .btn.ghost{background:transparent;color:var(--text);box-shadow:inset 0 0 0 2px currentColor}
    .btn[disabled]{opacity:.6;cursor:wait}
    .muted{opacity:.72}
    .grid{display:grid;gap:22px;grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
    .card{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.05),0 8px 24px rgba(0,0,0,.05);text-decoration:none;display:flex;flex-direction:column}
    .card .body{padding:16px 18px 20px}
    .card h3{margin:0 0 4px;font-size:1.02rem;line-height:1.3}
    .price{font-weight:800}
    .usp{display:flex;flex-wrap:wrap;gap:10px 28px;justify-content:center;padding:12px 0;font-size:.92rem;font-weight:600}
    .usp span::before{content:"✓ ";color:var(--primary)}
    header.site{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid rgba(0,0,0,.06)}
    header.site .wrap{display:flex;align-items:center;justify-content:space-between;height:66px}
    .logo{font-weight:800;font-size:1.25rem;text-decoration:none;letter-spacing:-.01em}
    .logo b{color:var(--primary)}
    nav.main{display:flex;gap:22px;align-items:center;font-weight:600}
    nav.main a{text-decoration:none}
    .cart-link{position:relative}
    .cart-count{position:absolute;top:-8px;right:-14px;background:var(--primary);color:#fff;border-radius:999px;font-size:.72rem;min-width:20px;height:20px;display:grid;place-items:center;padding:0 5px}
    footer.site{margin-top:80px;padding:48px 0 32px;background:#111;color:#eee;font-size:.92rem}
    footer.site .cols{display:grid;gap:28px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
    footer.site a{color:#eee;opacity:.85;text-decoration:none;display:block;padding:3px 0}
    footer.site a:hover{opacity:1;text-decoration:underline}
    h1,h2,h3{line-height:1.15;letter-spacing:-.015em}
    .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    #consent{position:fixed;inset:auto 16px 16px 16px;max-width:560px;margin-left:auto;background:#fff;color:#111;border-radius:16px;padding:20px;box-shadow:0 10px 40px rgba(0,0,0,.2);z-index:50;font-size:.92rem;display:none}
    #consent[data-open]{display:block}
    #consent .row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
    #consent .btn{padding:.6em 1.1em}
    #consent label{display:flex;gap:8px;align-items:center;margin:6px 0}
    @media (max-width:640px){nav.main .hide-sm{display:none}body{font-size:16px}}
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>
  <script is:inline define:vars={{ cfg: { ga4: analytics.ga4, metaPixel: analytics.metaPixel, store: store.id, currency: store.currency, base: u(''), demo: DEMO } }}>window.STORE_CFG = cfg;</script>
  <script is:inline src={u('/js/consent.js')} defer></script>
  <script is:inline src={u('/js/cart.js')} defer></script>
  <script is:inline src={u('/js/ab.js')} defer></script>
</head>
<body>
  <a class="sr-only" href="#main">Naar de inhoud</a>
  {DEMO && <div style="background:#111;color:#fff;text-align:center;font-size:.85rem;padding:6px 12px">Demoversie: bestellen is nog niet mogelijk. Foto's zijn sfeerbeelden, geen productfoto's.</div>}
  <header class="site">
    <div class="wrap">
      <a class="logo" href={u('/')}>{store.name.split(' ')[0]}<b>{store.name.split(' ').slice(1).join(' ') ? ' ' + store.name.split(' ').slice(1).join(' ') : '.'}</b></a>
      <nav class="main" aria-label="Hoofdmenu">
        <a href={u('/producten/')} class="hide-sm">Shop</a>
        <a href={u('/info/verzending/')} class="hide-sm">Verzending</a>
        <a href={u('/winkelmand/')} class="cart-link" aria-label="Winkelmand">Winkelmand <span class="cart-count" data-cart-count hidden>0</span></a>
      </nav>
    </div>
  </header>
  <div style="background:var(--primary);color:#fff"><div class="wrap usp" style="color:#fff">{store.usps.slice(0, 3).map((u) => <span style="color:#fff">{u}</span>)}</div></div>
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="wrap">
      <div class="cols">
        <div>
          <div class="logo" style="color:#fff">{store.name}</div>
          <p class="muted">{store.tagline}</p>
          <p class="muted">{store.company.legalName}<br />{store.company.address}<br />Btw: {store.company.vat}<br /><a href={`mailto:${store.company.email}`}>{store.company.email}</a></p>
        </div>
        <div>
          <strong>Shop</strong>
          <a href={u('/producten/')}>Alle producten</a>
          <a href={u('/winkelmand/')}>Winkelmand</a>
        </div>
        <div>
          <strong>Klantenservice</strong>
          <a href={u('/info/verzending/')}>Verzending & levering</a>
          <a href={u('/info/retourneren/')}>Retourneren (14 dagen)</a>
          <a href={u('/info/contact/')}>Contact</a>
        </div>
        <div>
          <strong>Juridisch</strong>
          <a href={u('/info/algemene-voorwaarden/')}>Algemene voorwaarden</a>
          <a href={u('/info/privacy/')}>Privacybeleid</a>
          <a href={u('/info/cookies/')}>Cookiebeleid</a>
          <a href="#" data-consent-open>Cookie-instellingen</a>
        </div>
      </div>
      {usesStockPhotos && <p class="muted" style="margin-top:24px;font-size:.8rem">Sfeerbeelden via <a href="https://unsplash.com/?utm_source=ecom-stores&utm_medium=referral" style="display:inline">Unsplash</a>.</p>}
      <p class="muted" style="margin-top:32px">© {year} {store.name}. Prijzen incl. 21% btw. Betaal veilig met Bancontact, iDEAL, Visa, Mastercard of Apple Pay.</p>
    </div>
  </footer>
  <div id="consent" role="dialog" aria-modal="false" aria-labelledby="consent-title">
    <strong id="consent-title">Cookies op {store.name}</strong>
    <p>We gebruiken noodzakelijke cookies om de winkel te laten werken. Met jouw toestemming gebruiken we ook analytische en marketingcookies om de site te verbeteren en relevante advertenties te tonen. <a href={u('/info/cookies/')}>Meer info</a></p>
    <div data-consent-details hidden>
      <label><input type="checkbox" checked disabled /> Noodzakelijk</label>
      <label><input type="checkbox" data-consent-analytics /> Analytisch (Google Analytics)</label>
      <label><input type="checkbox" data-consent-marketing /> Marketing (Meta, Google Ads)</label>
    </div>
    <div class="row">
      <button class="btn" data-consent-accept>Alles accepteren</button>
      <button class="btn ghost" data-consent-reject>Alleen noodzakelijk</button>
      <button class="btn ghost" data-consent-customize>Instellingen</button>
      <button class="btn ghost" data-consent-save hidden>Opslaan</button>
    </div>
  </div>
</body>
</html>
